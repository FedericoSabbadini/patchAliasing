{
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex -> biber -> pdflatex x2",
      "tools": [
        "coursework-pdflatex",
        "coursework-biber",
        "coursework-pdflatex",
        "coursework-pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "coursework-pdflatex",
      "command": "powershell",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "Set-Location -LiteralPath '%DIR%'; pdflatex -interaction=nonstopmode -halt-on-error -synctex=1 '%DOCFILE%.tex'"
          ]
        },
        {
          "name": "coursework-biber",
      "command": "powershell",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "Set-Location -LiteralPath '%DIR%'; biber '%DOCFILE%'"
          ]
        }
      ]
    }
