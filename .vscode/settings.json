{
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex -> biber -> pdflatex x2",
      "tools": [
        "coursework-pdflatex",
        "coursework-biber",
        "coursework-pdflatex",
        "coursework-pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "coursework-pdflatex",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location -LiteralPath '%DIR%'; pdflatex -interaction=nonstopmode -halt-on-error -synctex=1 -output-directory=build '%DOCFILE%.tex'"
      ]
    },
    {
      "name": "coursework-biber",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Set-Location -LiteralPath '%DIR%'; biber --input-directory build --output-directory build '%DOCFILE%'"
      ]
    }
  ]
}
