@prefix pv: <http://www.semanticweb.org/solar/ontologies/2026/6/solar-aliasing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://www.semanticweb.org/solar/ontologies/2026/6/solar-aliasing> .

<http://www.semanticweb.org/solar/ontologies/2026/6/solar-aliasing>
    a owl:Ontology ;
    owl:versionIRI
        <http://www.semanticweb.org/solar/ontologies/2026/6/solar-aliasing/versions/2.0> ;
    owl:versionInfo "2.0" ;
    rdfs:label "Simplified PV Closed-Loop Control Ontology"@en ;
    rdfs:comment
        "A compact OWL 2 DL ontology for PV observations, environmental context, anomaly and observability assessments, and bounded single-agent power routing. Load, battery and grid values not present in the PV dataset are asserted or simulated. Threshold evaluation, Bayesian evidence, rule priority and setpoint calculation remain responsibilities of the operational layer."@en .

#################################################################
#    Object Properties
#################################################################

pv:hasAsset
    a owl:ObjectProperty ;
    rdfs:domain pv:PVSystem ;
    rdfs:range pv:EnergyAsset ;
    rdfs:label "has asset"@en .

pv:managedBy
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PVSystem ;
    rdfs:range pv:ControlAgent ;
    rdfs:label "managed by"@en .

pv:hasObservation
    a owl:ObjectProperty ;
    rdfs:domain pv:PVSystem ;
    rdfs:range pv:SystemObservation ;
    rdfs:label "has observation"@en .

pv:hasSignal
    a owl:ObjectProperty ;
    rdfs:domain pv:PhotovoltaicArray ;
    rdfs:range pv:TimeSeriesSignal ;
    rdfs:label "has signal"@en .

pv:hasRepresentation
    a owl:ObjectProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:PatchedRepresentation ;
    rdfs:label "has representation"@en ;
    rdfs:comment
        "This property is not functional: one signal may be assessed under several patch and stride configurations."@en .

pv:assessesRepresentation
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:PatchedRepresentation ;
    rdfs:label "assesses representation"@en .

pv:hasGenerationContext
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:GenerationContext ;
    rdfs:label "has generation context"@en .

pv:hasAnomaly
    a owl:ObjectProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:AnomalyState ;
    rdfs:label "has anomaly"@en ;
    rdfs:comment
        "Anomaly values are not mutually exclusive. The operational layer applies sensor-validity and safety precedence before asserting them."@en .

pv:hasObservabilityState
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:ObservabilityState ;
    rdfs:label "has observability state"@en .

pv:selectsMode
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:ControlMode ;
    rdfs:label "selects mode"@en .

pv:makesDecision
    a owl:ObjectProperty ;
    rdfs:domain pv:ControlAgent ;
    rdfs:range pv:PowerRoutingDecision ;
    rdfs:label "makes decision"@en .

pv:basedOn
    a owl:ObjectProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            pv:SystemObservation
            pv:ObservabilityAssessment
            pv:GenerationContext
            pv:AnomalyState
            pv:ObservabilityState
        )
    ] ;
    rdfs:label "based on"@en ;
    rdfs:comment
        "Minimal evidence link from a decision to its observation, assessment or asserted semantic state."@en .

pv:hasRoute
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:PowerRoute ;
    rdfs:label "has route"@en ;
    rdfs:comment
        "Present exactly once for an active transfer and absent for a pure hold decision."@en .

pv:hasSourceAsset
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:EnergyAsset ;
    rdfs:label "has source asset"@en .

pv:hasDestinationAsset
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:EnergyAsset ;
    rdfs:label "has destination asset"@en .

#################################################################
#    Data Properties
#################################################################

# Observation values. Property names encode the units used by the coursework.

pv:pvPowerW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "PV power in watts"@en .

pv:powerRampRateWPerS
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "PV power ramp rate in watts per second"@en .

pv:tiltedIrradianceWm2
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "tilted irradiance in watts per square metre"@en .

pv:horizontalIrradianceWm2
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "horizontal irradiance in watts per square metre"@en .

pv:airTemperatureC
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "air temperature in degrees Celsius"@en .

pv:windSpeedMs
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "wind speed in metres per second"@en .

pv:windDirectionDeg
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:DirectionDegrees ;
    rdfs:label "wind direction in degrees"@en .

pv:batterySoC
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "battery state of charge"@en .

pv:loadDemandW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "aggregate internal-load demand in watts"@en ;
    rdfs:comment
        "Asserted or simulated aggregate demand for the passive internal load."@en .

pv:gridExchangeReferenceW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "grid-exchange reference in watts"@en ;
    rdfs:comment
        "Optional signed reference. Positive values denote export and negative values denote import."@en .

pv:observationTimestamp
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:dateTime ;
    rdfs:label "observation timestamp"@en .

pv:pvPowerValid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "PV power valid"@en .

pv:tiltedIrradianceValid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "tilted irradiance valid"@en .

pv:batterySoCValid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "battery state of charge valid"@en .

pv:loadDemandValid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:SystemObservation ;
    rdfs:range xsd:boolean ;
    rdfs:label "load demand valid"@en .

# Battery configuration.

pv:capacityWh
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:PositiveDecimal ;
    rdfs:label "capacity in watt-hours"@en .

pv:reserveSoC
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "reserve state of charge"@en .

pv:targetSoC
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "target state of charge"@en .

pv:maximumSoC
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "maximum state of charge"@en .

pv:maximumChargePowerW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "maximum charge power in watts"@en .

pv:maximumDischargePowerW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:BatteryStorage ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "maximum discharge power in watts"@en .

# Signal and patched-representation descriptors.

pv:signalFrequencyHz
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:PositiveDecimal ;
    rdfs:label "signal frequency in hertz"@en .

pv:samplingFrequencyHz
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:PositiveDecimal ;
    rdfs:label "sampling frequency in hertz"@en .

pv:periodSamples
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:PositiveDecimal ;
    rdfs:label "period in samples"@en .

pv:amplitudeW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "amplitude in watts"@en .

pv:timeSpanSeconds
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range pv:PositiveDecimal ;
    rdfs:label "time span in seconds"@en .

pv:phaseOffsetSamples
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:TimeSeriesSignal ;
    rdfs:range xsd:decimal ;
    rdfs:label "phase offset in samples"@en .

pv:patchSize
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PatchedRepresentation ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "patch size in samples"@en .

pv:stride
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PatchedRepresentation ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "stride in samples"@en .

pv:overlapRatio
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PatchedRepresentation ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "derived patch-overlap ratio"@en ;
    rdfs:comment
        "Derived as (patchSize - stride) / patchSize; it is descriptive and is not an aliasing rule."@en .

# Empirical observability evidence.

pv:analysisStatus
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:string ;
    rdfs:label "analysis status"@en .

pv:assessmentMethod
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:string ;
    rdfs:label "assessment method"@en .

pv:assessmentMetric
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:string ;
    rdfs:label "assessment metric"@en .

pv:strideLockingRatio
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "stride-locking ratio"@en .

pv:patchLockingRatio
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "patch-periodicity ratio"@en .

pv:lockingTolerance
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "locking tolerance"@en .

pv:effectEstimate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "effect estimate"@en .

pv:posteriorLossProbability
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "posterior information-loss probability"@en .

pv:credibleIntervalLower
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "credible-interval lower bound"@en .

pv:credibleIntervalUpper
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:decimal ;
    rdfs:label "credible-interval upper bound"@en .

pv:assessmentTimestamp
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:ObservabilityAssessment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assessment timestamp"@en .

# Decision values and commands.

pv:powerSetpointW
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:NonNegativeDecimal ;
    rdfs:label "optional power setpoint in watts"@en .

pv:decisionConfidence
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:UnitInterval ;
    rdfs:label "optional decision confidence"@en .

pv:batteryCommand
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:BatteryCommandDatatype ;
    rdfs:label "battery command"@en .

pv:pvCommand
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:PVCommandDatatype ;
    rdfs:label "PV command"@en .

pv:gridCommand
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain pv:PowerRoutingDecision ;
    rdfs:range pv:GridCommandDatatype ;
    rdfs:label "grid command"@en .

#################################################################
#    Base Classes and Cardinalities
#################################################################

pv:PVSystem
    a owl:Class ;
    rdfs:label "PV system"@en ;
    rdfs:comment
        "Aggregate boundary governed by one control agent and containing one asset of each supported type."@en ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty pv:hasAsset ;
            owl:allValuesFrom pv:EnergyAsset
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:hasAsset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:PhotovoltaicArray
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:hasAsset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:BatteryStorage
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:hasAsset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:ExternalGrid
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:hasAsset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:InternalLoad
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:managedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:ControlAgent
        ] .

pv:EnergyAsset
    a owl:Class ;
    rdfs:label "energy asset"@en ;
    owl:disjointUnionOf (
        pv:PhotovoltaicArray
        pv:BatteryStorage
        pv:ExternalGrid
        pv:InternalLoad
    ) .

pv:PhotovoltaicArray
    a owl:Class ;
    rdfs:subClassOf pv:EnergyAsset ;
    rdfs:label "photovoltaic array"@en .

pv:BatteryStorage
    a owl:Class ;
    rdfs:subClassOf pv:EnergyAsset ;
    rdfs:label "battery storage"@en .

pv:ExternalGrid
    a owl:Class ;
    rdfs:subClassOf pv:EnergyAsset ;
    rdfs:label "external grid"@en ;
    rdfs:comment
        "Available bidirectional boundary bus that supplies residual demand and accepts residual production."@en .

pv:InternalLoad
    a owl:Class ;
    rdfs:subClassOf pv:EnergyAsset ;
    rdfs:label "aggregate internal load"@en ;
    rdfs:comment
        "Passive sink representing a factory or a fleet of machines. It has no agent, subtype hierarchy, curtailment command or demand-scheduling model."@en .

pv:ControlAgent
    a owl:Class ;
    rdfs:label "control agent"@en .

pv:SystemObservation
    a owl:Class ;
    rdfs:label "system observation"@en ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty pv:hasGenerationContext ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:GenerationContext
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:observationTimestamp ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:dateTime
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:pvPowerValid ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:tiltedIrradianceValid ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:batterySoCValid ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:loadDemandValid ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean
        ] .

pv:TimeSeriesSignal
    a owl:Class ;
    rdfs:label "time-series signal"@en .

pv:PatchedRepresentation
    a owl:Class ;
    rdfs:label "patched representation"@en ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty pv:patchSize ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:positiveInteger
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:stride ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:positiveInteger
        ] .

pv:ObservabilityAssessment
    a owl:Class ;
    rdfs:label "observability assessment"@en ;
    rdfs:comment
        "Empirical evidence about information preservation for one patched representation. The state is asserted after the external experiment; no frequency threshold is encoded in OWL."@en ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty pv:assessesRepresentation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:PatchedRepresentation
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:hasObservabilityState ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:ObservabilityState
        ] .

pv:GenerationContext
    a owl:Class ;
    rdfs:label "generation context"@en ;
    rdfs:comment
        "Operational proxy inferred from validated tilted irradiance, not a meteorological diagnosis."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            pv:ClearSky
            pv:PartialCloud
            pv:Overcast
            pv:Nighttime
        )
    ] .

pv:AnomalyState
    a owl:Class ;
    rdfs:label "anomaly state"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            pv:InverterTrip
            pv:RampEvent
            pv:SensorMalfunction
        )
    ] .

pv:ObservabilityState
    a owl:Class ;
    rdfs:label "observability state"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            pv:Observable
            pv:PartiallyObservable
            pv:StructurallyAliased
        )
    ] .

pv:ControlMode
    a owl:Class ;
    rdfs:label "control mode"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            pv:NormalMode
            pv:ConservativeMode
            pv:SafeMode
        )
    ] .

pv:PowerRoute
    a owl:Class ;
    rdfs:label "power route"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            pv:PVToInternalLoad
            pv:PVToBattery
            pv:PVToExternalGrid
            pv:BatteryToInternalLoad
            pv:BatteryToExternalGrid
            pv:ExternalGridToInternalLoad
            pv:ExternalGridToBattery
        )
    ] .

pv:PowerRoutingDecision
    a owl:Class ;
    rdfs:label "power-routing decision"@en ;
    rdfs:comment
        "One active directional transfer or one pure hold decision. Multiple transfers in the same control cycle are represented by multiple instances. The operational layer evaluates SafeMode before ConservativeMode, a valid ramp override, and normal routing. Normal routing is load-first: PV serves the load before battery charging and export; a deficit uses the battery down to reserve before grid import; at night the grid serves the load before restoring reserve. A positive ramp may charge to maximum state of charge. A negative-ramp battery export requires a valid export reference and is considered only after the load is served."@en ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty pv:selectsMode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass pv:ControlMode
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:basedOn ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:batteryCommand ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange pv:BatteryCommandDatatype
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:pvCommand ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange pv:PVCommandDatatype
        ],
        [
            a owl:Restriction ;
            owl:onProperty pv:gridCommand ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange pv:GridCommandDatatype
        ],
        [
            a owl:Class ;
            owl:unionOf (
                [
                    a owl:Class ;
                    owl:intersectionOf (
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasRoute ;
                            owl:cardinality "0"^^xsd:nonNegativeInteger
                        ]
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasSourceAsset ;
                            owl:cardinality "0"^^xsd:nonNegativeInteger
                        ]
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasDestinationAsset ;
                            owl:cardinality "0"^^xsd:nonNegativeInteger
                        ]
                    )
                ]
                [
                    a owl:Class ;
                    owl:intersectionOf (
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasRoute ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass pv:PowerRoute
                        ]
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasSourceAsset ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass pv:EnergyAsset
                        ]
                        [
                            a owl:Restriction ;
                            owl:onProperty pv:hasDestinationAsset ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass pv:EnergyAsset
                        ]
                    )
                ]
            )
        ] .

#################################################################
#    Closed Datatype Vocabularies
#################################################################

pv:NonNegativeDecimal
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions (
            [ xsd:minInclusive "0"^^xsd:decimal ]
        )
    ] .

pv:PositiveDecimal
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions (
            [ xsd:minExclusive "0"^^xsd:decimal ]
        )
    ] .

pv:UnitInterval
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions (
            [ xsd:minInclusive "0"^^xsd:decimal ]
            [ xsd:maxInclusive "1"^^xsd:decimal ]
        )
    ] .

pv:DirectionDegrees
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions (
            [ xsd:minInclusive "0"^^xsd:decimal ]
            [ xsd:maxExclusive "360"^^xsd:decimal ]
        )
    ] .

pv:BatteryCommandDatatype
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:oneOf (
            "Charge"^^xsd:string
            "Discharge"^^xsd:string
            "Hold"^^xsd:string
        )
    ] .

pv:PVCommandDatatype
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:oneOf (
            "Connect"^^xsd:string
            "Isolate"^^xsd:string
        )
    ] .

pv:GridCommandDatatype
    a rdfs:Datatype ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:oneOf (
            "Import"^^xsd:string
            "Export"^^xsd:string
            "Balance"^^xsd:string
        )
    ] .

#################################################################
#    Route Endpoint Restrictions
#################################################################

# Each route value determines the asset types of the asserted endpoints.
# The exact-one endpoint cardinalities are inherited from the active-transfer
# branch of PowerRoutingDecision. Disjoint asset classes make the endpoints
# distinct without relying on procedural identity checks.

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:PVToInternalLoad ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:PhotovoltaicArray ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:InternalLoad ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:PVToBattery ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:PhotovoltaicArray ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:BatteryStorage ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:PVToExternalGrid ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:PhotovoltaicArray ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:ExternalGrid ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:BatteryToInternalLoad ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:BatteryStorage ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:InternalLoad ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:BatteryToExternalGrid ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:BatteryStorage ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:ExternalGrid ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:ExternalGridToInternalLoad ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:ExternalGrid ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:InternalLoad ] .

[
    a owl:Class ;
    owl:intersectionOf (
        pv:PowerRoutingDecision
        [ a owl:Restriction ; owl:onProperty pv:hasRoute ; owl:hasValue pv:ExternalGridToBattery ]
    )
]
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty pv:hasSourceAsset ; owl:allValuesFrom pv:ExternalGrid ],
        [ a owl:Restriction ; owl:onProperty pv:hasDestinationAsset ; owl:allValuesFrom pv:BatteryStorage ] .

#################################################################
#    Named Individuals
#################################################################

# Generation-context values.

pv:ClearSky
    a owl:NamedIndividual, pv:GenerationContext ;
    rdfs:label "clear sky"@en .

pv:PartialCloud
    a owl:NamedIndividual, pv:GenerationContext ;
    rdfs:label "partial cloud"@en .

pv:Overcast
    a owl:NamedIndividual, pv:GenerationContext ;
    rdfs:label "overcast"@en .

pv:Nighttime
    a owl:NamedIndividual, pv:GenerationContext ;
    rdfs:label "nighttime"@en .

# Anomaly values. Sensor malfunction includes invalid PV power, tilted
# irradiance, battery state of charge or aggregate load demand.

pv:InverterTrip
    a owl:NamedIndividual, pv:AnomalyState ;
    rdfs:label "inverter trip"@en .

pv:RampEvent
    a owl:NamedIndividual, pv:AnomalyState ;
    rdfs:label "ramp event"@en .

pv:SensorMalfunction
    a owl:NamedIndividual, pv:AnomalyState ;
    rdfs:label "sensor malfunction"@en .

# Observability values.

pv:Observable
    a owl:NamedIndividual, pv:ObservabilityState ;
    rdfs:label "observable"@en ;
    rdfs:comment
        "Positive evidence shows that the tested representation preserves the task-relevant information within the declared tolerance."@en .

pv:PartiallyObservable
    a owl:NamedIndividual, pv:ObservabilityState ;
    rdfs:label "partially observable"@en ;
    rdfs:comment
        "Preservation has not been certified and structural aliasing has not been confirmed; the representation is only partially trusted."@en .

pv:StructurallyAliased
    a owl:NamedIndividual, pv:ObservabilityState ;
    rdfs:label "structurally aliased"@en ;
    rdfs:comment
        "Candidate locking geometry and empirically confirmed task-relevant information loss are both present."@en .

# Control-mode values.

pv:NormalMode
    a owl:NamedIndividual, pv:ControlMode ;
    rdfs:label "normal mode"@en .

pv:ConservativeMode
    a owl:NamedIndividual, pv:ControlMode ;
    rdfs:label "conservative mode"@en .

pv:SafeMode
    a owl:NamedIndividual, pv:ControlMode ;
    rdfs:label "safe mode"@en .

# The complete closed set of admissible active transfer routes.

pv:PVToInternalLoad
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "PV to internal load"@en .

pv:PVToBattery
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "PV to battery"@en .

pv:PVToExternalGrid
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "PV to external grid"@en .

pv:BatteryToInternalLoad
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "battery to internal load"@en .

pv:BatteryToExternalGrid
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "battery to external grid"@en .

pv:ExternalGridToInternalLoad
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "external grid to internal load"@en .

pv:ExternalGridToBattery
    a owl:NamedIndividual, pv:PowerRoute ;
    rdfs:label "external grid to battery"@en .

# Vocabulary classes are disjoint, and every vocabulary value is globally
# distinct. This closes accidental identity across and within enumerations.

[]
    a owl:AllDisjointClasses ;
    owl:members (
        pv:GenerationContext
        pv:AnomalyState
        pv:ObservabilityState
        pv:ControlMode
        pv:PowerRoute
    ) .

[]
    a owl:AllDifferent ;
    owl:distinctMembers (
        pv:ClearSky
        pv:PartialCloud
        pv:Overcast
        pv:Nighttime
        pv:InverterTrip
        pv:RampEvent
        pv:SensorMalfunction
        pv:Observable
        pv:PartiallyObservable
        pv:StructurallyAliased
        pv:NormalMode
        pv:ConservativeMode
        pv:SafeMode
        pv:PVToInternalLoad
        pv:PVToBattery
        pv:PVToExternalGrid
        pv:BatteryToInternalLoad
        pv:BatteryToExternalGrid
        pv:ExternalGridToInternalLoad
        pv:ExternalGridToBattery
    ) .
